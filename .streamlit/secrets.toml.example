# Local: copy to .streamlit/secrets.toml (git-ignored).
# Streamlit Cloud: paste these lines into App settings -> Secrets.
GOOGLE_API_KEY = "your-gemini-api-key"
GEMINI_MODEL = "gemini-3.5-flash-lite"
GEMINI_EMBEDDING_MODEL = "models/gemini-embedding-001"

LANGSMITH_TRACING = "true"
LANGSMITH_API_KEY = "your-langsmith-api-key"
LANGSMITH_PROJECT = "weather-storm-agent"

# Unlocks owner mode (LangSmith usage, all visitors' reports). Use your OWN long random password
# (12+ characters); example values are rejected. Leave the line commented out to disable owner mode.
# ADMIN_PASSWORD = ""
